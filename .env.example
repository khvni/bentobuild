# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Unsplash API Configuration (Optional - for image generation)
# Get your API key from: https://unsplash.com/developers
# Free tier: 50 requests/hour
# If not set, falls back to placeholder images (Picsum Photos)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Daytona API Key for preview/deployment
# Get your API key from https://www.daytona.io/dashboard
# If not set, the preview will run in mock mode (returns local URLs)
# When configured, creates real Daytona sandboxes with live preview URLs
DAYTONA_API_KEY=your_api_key_here

# Database Configuration (Supabase PostgreSQL)
# Replace [YOUR-PASSWORD] with your actual Supabase database password
# Get your connection strings from: https://supabase.com/dashboard/project/_/settings/database
# DATABASE_URL: Used for connection pooling (pgBouncer) - better for serverless
# DIRECT_URL: Direct connection to database - required for migrations
DATABASE_URL="postgresql://postgres.futpuaxcyezkvrnfflmd:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.futpuaxcyezkvrnfflmd:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# GitHub OAuth Configuration
# Create an OAuth app at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth Configuration
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Upstash Redis for Rate Limiting (Security)
# Get your credentials from: https://console.upstash.com/redis
# Free tier: 10,000 requests/day
# If not set, rate limiting will be disabled (development mode)
# Note: Rate limiting protects your AI API costs and prevents abuse
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
