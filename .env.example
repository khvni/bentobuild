# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Unsplash API Configuration (Optional - for image generation)
# Get your API key from: https://unsplash.com/developers
# Free tier: 50 requests/hour
# If not set, falls back to placeholder images (Picsum Photos)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Daytona API Key for preview/deployment
# Get your API key from https://www.daytona.io/dashboard
# If not set, the preview will run in mock mode (returns local URLs)
# When configured, creates real Daytona sandboxes with live preview URLs
DAYTONA_API_KEY=your_api_key_here
